{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://esphome-lvgl-studio/addon-manifest.schema.json",
  "title": "ESPHome LVGL Studio – Addon-Manifest",
  "description": "Deklaratives Addon für ESPHome LVGL Studio. Dokumentation: docs/ADDONS.md",
  "type": "object",
  "required": ["id", "name", "version", "fields", "widgets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "Eindeutige id, Konvention <herkunft>.<name>"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "api": { "type": "integer", "enum": [1] },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "homepage": { "type": "string" },
    "icon": { "type": "string", "description": "Ein Emoji" },
    "settings": {
      "type": "array",
      "description": "Felder, die einmal pro Installation gelten ({{ settings.<key> }})",
      "items": { "$ref": "#/definitions/field" }
    },
    "fields": {
      "type": "array",
      "description": "Felder je Instanz ({{ config.<key> }})",
      "items": { "$ref": "#/definitions/field" }
    },
    "outputs": {
      "type": "array",
      "description": "Abgeleitete Werte ({{ out.<key> }}), in Reihenfolge ausgewertet",
      "items": { "$ref": "#/definitions/output" }
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/widget" }
    },
    "yaml": {
      "type": "string",
      "description": "Zusätzliche Top-Level-Komponenten als YAML-Template. ids sollten mit addon_{{ iid }} beginnen."
    },
    "preview": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "image" },
        "url": { "type": "string" },
        "interval": { "type": "number", "description": "Sekunden zwischen Aktualisierungen (0 = einmal)" }
      }
    }
  },
  "definitions": {
    "condition": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "description": "key ohne Punkt wird als config.<key> gelesen",
      "properties": {
        "key": { "type": "string" },
        "equals": {},
        "not": {},
        "in": { "type": "array" },
        "truthy": { "type": "boolean" }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "kind", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "text",
            "number",
            "slider",
            "select",
            "remote-select",
            "checkbox",
            "color",
            "size",
            "map",
            "ha-entity",
            "note"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "default": {},
        "placeholder": { "type": "string" },
        "password": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "unit": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "url": { "type": "string", "description": "remote-select: URL-Template" },
        "itemsPath": { "type": "string", "description": "remote-select: Punkt-Pfad zur Liste/zum Objekt" },
        "valueKey": { "type": "string" },
        "labelKey": { "type": "string" },
        "presets": { "type": "array", "items": { "type": "string", "pattern": "^\\d+x\\d+$" } },
        "spanKm": {
          "type": "object",
          "required": ["min", "max", "default"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "default": { "type": "number" }
          }
        },
        "aspectFrom": { "type": "string", "description": "map: Pfad auf ein size-Feld, z. B. config.size" },
        "tileUrl": {
          "type": "string",
          "description": "map: Kachel-URL mit {z}/{x}/{y} (Templates erlaubt). Ohne Angabe die Standardquelle."
        },
        "tileAttribution": { "type": "string", "description": "map: Quellenangabe zur tileUrl" },
        "visibleIf": { "$ref": "#/definitions/condition" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "select" } }, "required": ["kind"] },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "kind": { "const": "remote-select" } }, "required": ["kind"] },
          "then": { "required": ["url"] }
        }
      ]
    },
    "output": {
      "type": "object",
      "required": ["key", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["template", "calc", "switch", "bbox"] },
        "value": { "type": "string", "description": "template" },
        "expr": { "type": "string", "description": "calc: + - * / % ^, min/max/round/floor/ceil/abs/sqrt/cos/sin/tan/rad/deg/pow, pi, e" },
        "digits": { "type": "number" },
        "on": { "type": "string", "description": "switch: Pfad, dessen Wert den Fall bestimmt" },
        "cases": { "type": "object", "additionalProperties": { "type": "string" } },
        "fallback": { "type": "string" },
        "lat": { "type": ["string", "number"] },
        "lon": { "type": ["string", "number"] },
        "spanKm": { "type": ["string", "number"] },
        "width": { "type": ["string", "number"] },
        "height": { "type": ["string", "number"] },
        "order": { "enum": ["wsen", "swne"], "description": "bbox: Achsenreihenfolge (swne für WMS 1.3.0 / EPSG:4326)" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "template" } }, "required": ["kind"] },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "kind": { "const": "calc" } }, "required": ["kind"] },
          "then": { "required": ["expr"] }
        },
        {
          "if": { "properties": { "kind": { "const": "switch" } }, "required": ["kind"] },
          "then": { "required": ["on", "cases"] }
        },
        {
          "if": { "properties": { "kind": { "const": "bbox" } }, "required": ["kind"] },
          "then": { "required": ["lat", "lon", "spanKm", "width", "height"] }
        }
      ]
    },
    "widget": {
      "type": "object",
      "required": ["key", "type"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "__root" },
          "description": "Stabil – daran hängt die Zuordnung zum erzeugten Widget. '__root' ist reserviert (automatischer Gruppen-Container)."
        },
        "type": {
          "enum": [
            "obj",
            "button",
            "label",
            "icon",
            "image",
            "slider",
            "arc",
            "bar",
            "switch",
            "checkbox",
            "led",
            "dropdown",
            "textarea",
            "spinner",
            "line",
            "meter",
            "qrcode"
          ]
        },
        "name": { "type": "string" },
        "x": { "type": ["string", "number"], "description": "Versatz zum ersten Widget der Instanz (nur beim Anlegen)" },
        "y": { "type": ["string", "number"] },
        "width": { "type": ["string", "number"] },
        "height": { "type": ["string", "number"] },
        "props": { "type": "object" },
        "entity": { "type": "string", "description": "Home-Assistant-Entity (Template erlaubt)" },
        "children": { "type": "array", "items": { "$ref": "#/definitions/widget" } },
        "visibleIf": { "$ref": "#/definitions/condition" }
      }
    }
  }
}
